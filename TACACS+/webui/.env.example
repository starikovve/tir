# Скопируйте в .env и подставьте свои значения. Файл .env не коммитят.
# openssl rand -hex 32
APP_SECRET_KEY=

# Каталог sqlite. Для systemd удобен абсолютный путь.
DATABASE_URL=sqlite:////opt/tacacs-ui/tacacs-ui.sqlite

# Файл или каталог журнала accounting tac_plus-ng.
# Каталог читается рекурсивно (учёт по дням: acct/ГГГГ/ММ/ДД.log).
ACCOUNTING_LOG=/var/log/tac_plus-ng/acct

# true за nginx с HTTPS: у cookie будет флаг Secure.
# HttpOnly и SameSite=Lax приложение ставит всегда.
# Для голого HTTP (uvicorn без TLS) поставьте false,
# иначе браузер не сохранит cookie и вход будет «не держаться».
SESSION_COOKIE_SECURE=false

# Лимит POST /login с одного адреса. Формат: число/second|minute|hour|day.
LOGIN_RATE_LIMIT=5/minute

# Первый администратор создаётся один раз, только если таблица пользователей пуста.
# Дальнейшие правки этих двух переменных пароль не меняют.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
