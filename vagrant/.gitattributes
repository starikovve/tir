# Windows часто превращает перевод строки в CRLF. В гостевой Ubuntu
# bash не запускает скрипт с CR, а Vagrantfile читается как Ruby.
# Эти правила держат LF при checkout.
*.sh text eol=lf
*.py text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.md text eol=lf
Vagrantfile text eol=lf
scripts/* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
